# PrimeCrypto Environment Configuration
# Copy this file to .env and fill in your values

# Deployer private key (DO NOT COMMIT!)
PRIVATE_KEY=your_private_key_here

# Block explorer API key for contract verification
BASESCAN_API_KEY=your_basescan_api_key

# Optional: Alchemy/Infura RPC URLs
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_MAINNET_RPC=https://mainnet.base.org

# Prime AI Integration
PRIME_AI_ORCHESTRATOR_URL=http://localhost:3002
PRIME_AI_MESSAGE_BUS_URL=ws://localhost:3003
